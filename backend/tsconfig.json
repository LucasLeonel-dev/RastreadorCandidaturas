{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Node 24",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],

    "rootDir": "./src",
    "outDir": "./build",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "ignoreDeprecations": "6.0",
 
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
